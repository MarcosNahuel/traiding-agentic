# === IOL (cuenta real — máxima sensibilidad, NUNCA commitear el .env real) ===
IOL_USERNAME=tu_usuario_iol
IOL_PASSWORD=tu_password_iol
# Base de la API. Producción: https://api.invertironline.com
# Sandbox/homologación (recomendado para probar lecturas): https://api.homo.invertironline.com
IOL_API_BASE=https://api.invertironline.com

# === Anthropic (Claude Agent SDK) ===
ANTHROPIC_API_KEY=sk-ant-...

# === Telegram ===
TELEGRAM_BOT_TOKEN=123456:ABC-...
# Tu chat id: solo este usuario puede operar (allowlist). Conseguilo con @userinfobot
TELEGRAM_ALLOWED_CHAT_ID=123456789

# === Modelos (mixtos) ===
MODEL_ORCHESTRATOR=opus
MODEL_DATA=haiku
MODEL_KNOWLEDGE=sonnet

# === Límites duros de seguridad ===
# Monto máximo por orden (en la moneda de la orden, ej. USD)
MAX_ORDER_AMOUNT=2000
# Tope total operado por día
MAX_DAILY_AMOUNT=5000
# Símbolos permitidos para operar (coma-separados). Vacío = permite todos los validados.
ALLOWED_SYMBOLS=SPY,AAPL,QQQ,MELI,KO
# Minutos antes de que una orden pendiente expire sola
ORDER_CONFIRMATION_TIMEOUT_MIN=10

# === Estado / contexto ===
STATE_DB_PATH=./data/asesor.db
MARKET_CONTEXT_PATH=./data/market-context.md
